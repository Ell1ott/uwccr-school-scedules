{
  "name": "uwccr-school-schedules",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "if [ -n \"$VERCEL\" ]; then echo 'Skipping schedule update on Vercel'; else npm run update-schedule; fi",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "update-schedule": ".venv/bin/python scripts/convert_classlist.py && .venv/bin/python scripts/convert_calendar.py",
    "convert": ".venv/bin/python scripts/convert_classlist.py"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@supabase/supabase-js": "^2.112.4",
    "lucide-react": "^1.33.0",
    "posthog-js": "^1.419.4",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.12",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.1.12",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "web-push": "^3.6.7"
  }
}
